# Top level gitignore for Workbench Project

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/
!/.mvn/wrapper/maven-wrapper.jar
mvnw
mvnw.cmd

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secrets / Local config — never commit these
**/application-local.yml
**/.env
